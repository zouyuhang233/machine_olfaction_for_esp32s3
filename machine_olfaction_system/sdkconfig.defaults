# ============================================================
# Machine Olfaction Firmware - max out hardware resources
# Target: ESP32-S3-WROOM-1 N16R8 (16MB Flash + 8MB Octal PSRAM)
# Applied automatically when running: idf.py set-target esp32s3
# NOTE: keep this file pure ASCII - kconfgen on Windows may
#       decode it as GBK and choke on UTF-8 punctuation.
# ============================================================

# ---------- Flash: 16MB / QIO / 80MHz ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Write actual flash size into image header when flashing
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# ---------- Partition table: custom (app 4MB + storage 11.4MB + coredump 512KB) ----------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- CPU: 240MHz ----------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---------- PSRAM: 8MB Octal @80MHz, wired into malloc heap ----------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# alloc <= 16KB stays in internal SRAM (PSRAM is slower), larger goes to PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# WiFi/LWIP buffers in PSRAM to save internal SRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---------- Cache: max for PSRAM bandwidth ----------
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---------- Compiler: -O2 performance ----------
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---------- Task stacks: leave room for business code ----------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584

# ---------- FreeRTOS: 1ms tick for sensor sampling ----------
CONFIG_FREERTOS_HZ=1000

# ---------- Crash dump to flash ----------
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# ---------- Heap tracing (debug aid, negligible cost) ----------
CONFIG_HEAP_TRACING_STANDALONE=y
